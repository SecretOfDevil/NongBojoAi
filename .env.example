PORT=3000
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

ADMIN_KEY=change-this-admin-key
USD_TO_THB=36.5
UPLOAD_DIR=./uploads_tmp
MAX_FILE_SIZE_MB=20

# PromptPay receiver (phone number or national ID); set the real value only in .env/Vercel.
PROMPTPAY_ID=0812345678

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
# Optional: override the DashScope OpenAI-compatible endpoint for a regional deployment.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
